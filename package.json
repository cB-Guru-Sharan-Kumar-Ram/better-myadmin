{
  "name": "bettermyadmin-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:watch": "vitest --project unit"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.15.3",
    "turbo": "2.5.3",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/router-generator": "1.120.3",
      "@tanstack/router-utils": "1.115.0",
      "@tanstack/virtual-file-routes": "1.115.0",
      "rollup": "4.40.2"
    }
  }
}
